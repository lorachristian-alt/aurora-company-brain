 "passaggi_consegnati": [
  {
   "cid": 1809,
   "file": "verbale_CDA_approvazione_investimento_tunnel.docx",
   "origine": "nativa",
   "rerank": 0.9806807637214661,
   "testo": "Interviene la rag. Trentin, la quale rappresenta che la copertura dell'acconto potrà avvenire mediante utilizzo della linea di anticipo fatture in essere presso UniCredit S.p.A., filiale di Cologna Veneta (accordato € 400.000,00, utilizzo medio attuale € 180.000,00 circa), senza necessità di nuova finanza, e che per il saldo alla consegna è in corso di istruttoria con il medesimo istituto un finanziamento chirografario a 60 mesi, sul quale il dott. Bellotto riferisce di attendersi esito favorevole entro aprile. Il dott. Bellotto segnala inoltre l'opportunità di verificare l'accesso dell'investimento alle agevolazioni per beni strumentali vigenti nel 2026, riservandosi un approfondimento scritto.\n\n[Bellotto A. - lascerei \"vigenti nel 2026\" senza citare la singola misura: tra credito d'imposta 4.0 in esaurimento e nuova Transizione 5.0 il quadro cambia di mese in mese, nel verbale meglio la formula generica, il dettaglio lo metto nella mia nota.]"
  },
  {
   "cid": 1373,
   "file": "previsionale cassa giugno-agosto DEF (2).xlsx",
